{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "intt/megamenu",
  "version": "0.1.0",
  "title": "Mega Menú",
  "category": "theme",
  "icon": "menu",
  "description": "Barra de navegación principal con panel de megamenú.",
  "attributes": {
    "triggerLabel": {
      "type": "string",
      "default": "Menú"
